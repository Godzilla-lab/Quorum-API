{
  "name": "quorum-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node --disable-warning=ExperimentalWarning packages/server/src/bin.ts",
    "clean": "tsc -b --clean",
    "test": "node --disable-warning=ExperimentalWarning --test \"packages/**/*.test.ts\"",
    "lint": "tsc -b",
    "lint:copy": "node scripts/check-copy.mjs",
    "check:security": "node scripts/check-security.mjs",
    "verify": "npm run build && npm test && npm run lint:copy && npm run check:security && npm run check:drift:fixtures && npm run check:spec",
    "check:drift": "node scripts/check-drift.mjs",
    "check:drift:fixtures": "node scripts/check-drift.mjs --fixtures",
    "check:spec": "node --disable-warning=ExperimentalWarning scripts/check-spec.mjs",
    "check:parity": "node --disable-warning=ExperimentalWarning scripts/parity.mjs",
    "test:postgres": "node --disable-warning=ExperimentalWarning --test \"packages/corpus/src/drivers/postgres.{conformance,rls,concurrency}.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  }
}
